#!/bin/bash
# Helpers for the configure hook to manage user-set daemon.json options via
# `snap set docker daemon.<key>=<value>`.

# Keys a user may set via `snap set docker daemon.<key>=<value>`, which the configure
# hook merges into daemon.json. Whitelist safe keys. Keys with a value in the base config
# (e.g. log-level) are restored to that default when unset.
#
# Known dangerous keys are: hosts, tls*, authorization-plugins, runtimes,
# insecure-registries, registry-mirrors. We should have a good reason for adding
# them since they could grant network/root access.

USER_DAEMON_KEYS=(
    default-address-pools
    bip
    fixed-cidr
    fixed-cidr-v6
    default-gateway
    default-gateway-v6
    mtu
    dns
    dns-search
    dns-opts
    default-ulimits
    log-level
)

reject_unknown_daemon_config() {
    local allow doc bad
    allow="$(printf '%s\n' "${USER_DAEMON_KEYS[@]}" | jq -Rn '[inputs]')"
    doc="$(snapctl get -d daemon 2>/dev/null || true)"
    [ -n "$doc" ] || return 0
    # keys the user set that are not in the whitelist
    bad="$(jq -r --argjson allow "$allow" \
        '((.daemon // {}) | keys) - $allow | join(" ")' <<<"$doc" 2>/dev/null)"
    if [ -n "$bad" ]; then
        echo "error: daemon option(s) not configurable via snap: ${bad}" >&2
        echo "allowed daemon options: ${USER_DAEMON_KEYS[*]}" >&2
        return 1
    fi
}

# Merge whitelisted daemon options from snap config into daemon.json.
# Sets SVC_RESTART when the effective config changes.
apply_user_daemon_config() {
    local cfg="${SNAP_DATA}/config/daemon.json"
    local allow base doc overlay tmp
    allow="$(printf '%s\n' "${USER_DAEMON_KEYS[@]}" | jq -Rn '[inputs]')"
    doc="$(snapctl get -d daemon 2>/dev/null || true)"
    [ -n "$doc" ] || doc='{}'

    # Defaults for whitelisted keys, so unsetting a key that
    # has a base default restores that default instead of dockerd's built-in.
    base="$(jq -c --argjson allow "$allow" \
        'with_entries(select(.key as $k | $allow | index($k)))' "${SNAP}/config/daemon.json" 2>/dev/null || true)"
    jq -e 'type == "object"' <<<"$base" >/dev/null 2>&1 || base='{}'


    # Overlay = only the whitelisted keys the user has actually set.
    overlay="$(jq -c --argjson allow "$allow" \
        '(.daemon // {}) | with_entries(select(.key as $k | $allow | index($k)))' <<<"$doc" 2>/dev/null || true)"
    if ! jq -e 'type == "object"' <<<"$overlay" >/dev/null 2>&1; then
        echo "config: could not read daemon options; leaving daemon.json unchanged"
        return 0
    fi

    # Drop every whitelisted key, restore the snap defaults for them, then apply the ones the
    # user has set (user value wins). Keys the snap or nvidia otherwise manage are untouched.
    tmp="$(mktemp "${cfg}.XXXXXX")"
    if ! jq --argjson allow "$allow" --argjson base "$base" --argjson overlay "$overlay" \
        'delpaths([ $allow[] | [.] ]) | . + $base + $overlay' "$cfg" > "$tmp" 2>/dev/null; then
        echo "config: failed to merge daemon options; leaving daemon.json unchanged"
        rm -f "$tmp"
        return 0
    fi

    # Reject an invalid value so the snap set fails loudly instead of silently not applying.
    # dockerd needs $SNAP/bin on PATH to locate docker-proxy during validation.
    local err
    if ! err="$(PATH="${SNAP}/bin:${SNAP}/usr/bin:${PATH}" "${SNAP}/bin/dockerd" \
        --validate --config-file="$tmp" 2>&1)"; then
        echo "error: invalid daemon option value: ${err##*: }" >&2
        rm -f "$tmp"
        return 1
    fi

    # Only apply when the config actually changed
    if jq -S . "$cfg" 2>/dev/null | cmp -s - <(jq -S . "$tmp" 2>/dev/null); then
        rm -f "$tmp"
    else
        mv "$tmp" "$cfg"
        # shellcheck disable=SC2034
        SVC_RESTART=true
    fi
}
