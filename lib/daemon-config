#!/bin/bash
# Helpers for the configure hook to manage user-set daemon.json options via
# `snap set docker daemon.<key>=<value>`.

# Keys a user may set via `snap set docker daemon.<key>=<value>`, which the configure
# hook merges into daemon.json. Whitelist safe keys. Keys with a value in the base config
# (e.g. log-level) are restored to that default when unset.
#
# Known dangerous keys are: hosts, tls*, authorization-plugins, runtimes,
# insecure-registries, registry-mirrors. We should have a good reason for adding
# them since they could grant network/root access.
#
# Adding a key is cheap; removing one is a breaking change: the configure hook
# then rejects the stored value, which blocks every refresh until it is unset.

USER_DAEMON_KEYS=(
    bip
    bip6
    default-address-pools
    default-gateway
    default-gateway-v6
    default-ulimits
    dns
    dns-opts
    dns-search
    fixed-cidr
    fixed-cidr-v6
    ipv6
    log-level
    mtu
)
DAEMON_CONFIG_ALLOW="$(printf '%s\n' "${USER_DAEMON_KEYS[@]}" | jq -Rn '[inputs]')"

# jq helpers shared by the programs below, so the whitelist filter cannot drift
# between call sites. unslice is slice's complement over any key array.
# shellcheck disable=SC2016
DAEMON_CONFIG_JQ='
def slice($keys): with_entries(select(.key as $k | $keys | index($k)));
def unslice($keys): with_entries(select(.key as $k | $keys | index($k) | not));
'

# State carried between runs: the keys applied by the previous run. Only those are
# dropped or reset on the next one, so values set by hand in daemon.json (or by
# nvidia) are left alone.
DAEMON_CONFIG_STATE="${SNAP_DATA}/daemon-config-state"
DAEMON_CONFIG_ROLLBACK="${SNAP_DATA}/.configure-rollback"

reject_unsupported_daemon_config() {
    local snap_cfg bad
    snap_cfg="$(snapctl get -d daemon 2>/dev/null || true)"
    [ -n "$snap_cfg" ] || return 0
    # `snap set docker daemon=foo` arrives as a non-object; reject it with a
    # message instead of letting jq abort the hook silently under set -e.
    if ! jq -e '(.daemon // {}) | type == "object"' <<<"$snap_cfg" >/dev/null 2>&1; then
        echo "error: daemon options must be set as daemon.<key>=<value>" >&2
        return 1
    fi
    # keys the user set that the snap does not support
    bad="$(jq -r --argjson allow "$DAEMON_CONFIG_ALLOW" \
        '((.daemon // {}) | keys) - $allow | join(" ")' <<<"$snap_cfg" 2>/dev/null || true)"
    if [ -n "$bad" ]; then
        echo "error: daemon option(s) not configurable via snap: ${bad}" >&2
        echo "allowed daemon options: ${USER_DAEMON_KEYS[*]}" >&2
        return 1
    fi
}

# Validate a daemon.json with dockerd. Prints the reason on failure.
validate_daemon_config() {
    local err
    # dockerd needs $SNAP/bin on PATH to locate docker-proxy during validation.
    if err="$(PATH="${SNAP}/bin:${SNAP}/usr/bin:${PATH}" "${SNAP}/bin/dockerd" \
        --validate --config-file="$1" 2>&1)"; then
        return 0
    fi
    echo "${err#unable to configure the Docker daemon with file *: }"
    return 1
}

# Merge whitelisted daemon options from snap config into daemon.json.
#
# The whitelisted slice of daemon.json is composed from three layers, later wins:
#   B: the defaults shipped in $SNAP/config/daemon.json
#   H: values set by hand in daemon.json: whatever the file holds for keys the
#      previous run did not write
#   O: snap config (`snapctl get daemon`)
# and three more names take part:
#   C: the current file, as it is now
#   P: what the previous run wrote, kept in $DAEMON_CONFIG_STATE as {result}
#   R: the composed result; stored in the state, it is the next run's P
# So a key P wrote goes back to B when snap config drops it, and a key P did not
# write is left as the file has it. Keys outside the whitelist are never touched.
# Sets SVC_RESTART when the effective config changes.
apply_user_daemon_config() {
    local cfg="${SNAP_DATA}/config/daemon.json"
    local statef="${DAEMON_CONFIG_STATE}"
    local allow="${DAEMON_CONFIG_ALLOW}"
    local base overlay snap_cfg state merged tmp
    snap_cfg="$(snapctl get -d daemon 2>/dev/null || true)"
    [ -n "$snap_cfg" ] || snap_cfg='{}'

    base="$(jq -c "$DAEMON_CONFIG_JQ"'slice($allow)' --argjson allow "$allow" \
        "${SNAP}/config/daemon.json" 2>/dev/null || true)"
    jq -e 'type == "object"' <<<"$base" >/dev/null 2>&1 || base='{}'

    # Overlay = only the whitelisted keys the user has actually set.
    overlay="$(jq -c "$DAEMON_CONFIG_JQ"'(.daemon // {}) | slice($allow)' \
        --argjson allow "$allow" <<<"$snap_cfg" 2>/dev/null || true)"
    if ! jq -e 'type == "object"' <<<"$overlay" >/dev/null 2>&1; then
        echo "config: could not read daemon options; leaving daemon.json unchanged" >&2
        return 0
    fi

    # Refuse a daemon.json that is not a JSON object, so the snap set fails instead of
    # committing an option that never reaches the file.
    local cfg_err
    if ! jq -e 'type == "object"' "$cfg" >/dev/null 2>&1; then
        cfg_err="$(validate_daemon_config "$cfg")" || true
        echo "error: existing ${cfg} is invalid: ${cfg_err:-not a JSON object}" >&2
        return 1
    fi

    state="$(cat "$statef" 2>/dev/null || true)"
    # A crash can land between the daemon.json mv and the state mv below; the staged
    # .new is adopted iff it describes the file as it is now.
    if [ -f "${statef}.new" ]; then
        local pending file_slice
        pending="$(cat "${statef}.new" 2>/dev/null || true)"
        file_slice="$(jq -c "$DAEMON_CONFIG_JQ"'slice($allow)' --argjson allow "$allow" \
            "$cfg" 2>/dev/null || echo null)"
        jq -e --argjson slice "$file_slice" '(.result // null) == $slice' \
            <<<"$pending" >/dev/null 2>&1 && state="$pending"
        rm -f "${statef}.new"
    fi
    jq -e 'type == "object" and ((.result // {}) | type == "object")' <<<"$state" >/dev/null 2>&1 \
        || state='{"result":{}}'

    if ! merged="$(jq -c "$DAEMON_CONFIG_JQ"'
        . as $file
        | slice($allow) as $C
        # only whitelisted keys may be dropped or reset, whatever the state claims
        | (($state.result // {}) | slice($allow)) as $P
        # R = (B|P) < (C - P) < O
        | (($B | slice($P | keys)) + ($C | unslice($P | keys)) + $O) as $R
        # file = its non-whitelisted keys + R
        | {file: (($file | unslice($allow)) + $R),
           state: {result: $R},
           changed: ($R != $C)}' \
        --argjson allow "$allow" --argjson B "$base" --argjson O "$overlay" \
        --argjson state "$state" "$cfg" 2>/dev/null)"; then
        echo "error: failed to merge daemon options into ${cfg}" >&2
        return 1
    fi

    tmp="$(mktemp "${cfg}.XXXXXX")"
    chmod 644 "$tmp" # mktemp creates it 0600
    jq '.file' <<<"$merged" > "$tmp"
    # Stage the new state before touching the file, so a crash between the two mvs
    # is recovered by the adoption check above.
    jq -c '.state' <<<"$merged" > "${statef}.new"

    # Reject an invalid value so the snap set fails loudly instead of silently not applying.
    # A file that already fails on its own is not the option's fault, so say so instead.
    local err
    if ! err="$(validate_daemon_config "$tmp")"; then
        rm -f "$tmp" "${statef}.new"
        if ! cfg_err="$(validate_daemon_config "$cfg")"; then
            echo "error: existing ${cfg} is invalid: ${cfg_err}" >&2
        else
            echo "error: invalid daemon option value: ${err}" >&2
        fi
        return 1
    fi

    # Only rewrite the file when its whitelisted slice changed, so hand formatting
    # survives a no-op run.
    if [ "$(jq -r '.changed' <<<"$merged")" = true ]; then
        mv "$tmp" "$cfg"
        # shellcheck disable=SC2034
        SVC_RESTART=true
    else
        rm -f "$tmp"
    fi
    # State is committed even when the file did not change: an unset that changes
    # nothing on disk still has to leave the key out of P.
    mv "${statef}.new" "$statef"
}

# Copy daemon.json and the state aside, for restore_daemon_config.
snapshot_daemon_config() {
    rm -rf "$DAEMON_CONFIG_ROLLBACK" && mkdir -p "$DAEMON_CONFIG_ROLLBACK"
    cp "${SNAP_DATA}/config/daemon.json" "${DAEMON_CONFIG_ROLLBACK}/daemon.json"
    [ ! -f "$DAEMON_CONFIG_STATE" ] || cp "$DAEMON_CONFIG_STATE" "${DAEMON_CONFIG_ROLLBACK}/state"
}

# Put the snapshot back. Returns 0 iff daemon.json actually changed, so the caller
# knows a service restart is warranted.
restore_daemon_config() {
    local cfg="${SNAP_DATA}/config/daemon.json" changed=1
    [ -f "${DAEMON_CONFIG_ROLLBACK}/daemon.json" ] || return 1
    if ! cmp -s "${DAEMON_CONFIG_ROLLBACK}/daemon.json" "$cfg"; then
        cp "${DAEMON_CONFIG_ROLLBACK}/daemon.json" "$cfg"
        changed=0
    fi
    if [ -f "${DAEMON_CONFIG_ROLLBACK}/state" ]; then
        cp "${DAEMON_CONFIG_ROLLBACK}/state" "$DAEMON_CONFIG_STATE"
    else
        rm -f "$DAEMON_CONFIG_STATE"
    fi
    return "$changed"
}
