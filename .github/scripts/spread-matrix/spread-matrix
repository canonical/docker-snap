#!/bin/bash
# Build the spread-tests fan-out matrix: read a spread job list on stdin
# (backend:system:suite/task lines, as printed by spread -list), apply the
# job filter given as $1 and print the GitHub Actions include-matrix as
# JSON on stdout -- one {system, jobs, shard, shards} entry per surviving
# system shard, so a lane can run a subset of tasks. Diagnostics go to stderr;
# exits 1 if the filter selects nothing or a s390x task has no manual shard.
#
# The filter is a chain of whitespace-separated EREs applied as successive
# greps over the job lines: each term narrows the selection ('|' inside a
# term expresses alternatives) and a '!' prefix inverts a term. An empty
# filter selects every job.
#
# An Ubuntu Core release pairs with its LTS (core-26 <-> 26.04), so terms
# treat them as one series: '26.04' selects core-26 too, '!26.04' drops
# it, and '26.10' leaves core alone. Greps therefore run over two
# tab-separated copies of each line -- the real job name plus a copy with
# the core version expanded to LTS form -- and the real name comes back
# out of column 1.
set -euf

FILTER="${1-}"

jobs="$(cat)"
matchable="$(paste <(printf '%s\n' "$jobs") <(sed -E 's/-core-([0-9]+)\./-core-\1.04./' <<<"$jobs"))"

# shellcheck disable=SC2086 # word splitting of $FILTER is the point; set -f keeps terms from globbing
for term in $FILTER; do
  case "$term" in
    ('!'*) matchable="$(grep -vE -- "${term#!}" <<<"$matchable" || true)" ;;
    (*)    matchable="$(grep -E -- "$term" <<<"$matchable" || true)" ;;
  esac
done
selected="$(cut -f1 <<<"$matchable")"

if [ -z "$selected" ]; then
  printf "error: filter '%s' selected no jobs\n" "$FILTER" >&2
  exit 1
fi
printf 'selected jobs:\n%s\n' "$selected" >&2

# Group jobs by system. s390x uses manual shards because daemon_config restarts
# dockerd repeatedly and dominates that system's run time.
groups="$(awk -F: '
  {
    sys = $2
    job = $3
    sub(/^.*\//, "", job)
    shard = 1
    if (sys ~ /\.s390x$/) {
      if (job ~ /^(build|commit|copy|export_and_import|hello-world|installation|kill)$/) shard = 1
      else if (job ~ /^(restart_always|restart_on_failure|save_and_load|simple_container|start_and_stop|update_policy|version)$/) shard = 2
      else if (job == "daemon_config") shard = 3
      else {
        printf "error: no manual s390x shard for task %s\n", job > "/dev/stderr"
        bad = 1
        next
      }
    }
    key = sys "\t" shard
    g[key] = g[key] " " $0
  }
  END {
    if (bad) exit 1
    for (key in g) {
      split(key, fields, "\t")
      print fields[1] "\t" fields[2] "\t" substr(g[key], 2)
    }
  }
' <<<"$selected")"

# The UI job list shows matrix order and awk's for-in order is arbitrary,
# so sort: newest release first, architectures together within a release.
# Prepend the bare release number as a sort key (system name minus flavour
# prefix and architecture suffix), version-sort descending on it, then
# drop the key again.
sorted="$(awk -F'\t' '{key=$1; sub(/^[a-z-]+-/, "", key); sub(/\.[a-z0-9]+$/, "", key); print key "\t" $0}' <<<"$groups" \
  | sort -t"$(printf '\t')" -k1,1Vr -k2,2 -k3,3n | cut -f2-)"

jq -Rsc '{include: [split("\n")[] | select(length>0) | split("\t") | {system: .[0], shard: (.[1] | tonumber), shards: (if (.[0] | endswith(".s390x")) then 3 else 1 end), jobs: .[2]}]}' <<<"$sorted"
