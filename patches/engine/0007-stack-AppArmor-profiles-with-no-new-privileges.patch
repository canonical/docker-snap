From 10837bd4d5e03bc79e0d21ca1b6960e338629490 Mon Sep 17 00:00:00 2001
From: Oliver Calder <oliver.calder@canonical.com>
Date: Mon, 28 Sep 2026 12:00:00 +0000
Subject: [PATCH 7/7] stack AppArmor profiles with no new privileges

AppArmor rejects replacing the dockerd snap profile with a container
profile after no_new_privs is set. Request profile stacking in that case
so the container profile further restricts the existing snap confinement.

Keep replacement transitions for processes without no_new_privs to avoid
changing their existing confinement semantics.
---
 daemon/apparmor_linux.go      |  9 +++++++++
 daemon/apparmor_linux_test.go | 31 +++++++++++++++++++++++++++++++
 daemon/exec_linux.go          |  2 +-
 daemon/exec_linux_test.go     | 15 ++++++++++++++-
 daemon/oci_linux.go           |  2 +-
 5 files changed, 56 insertions(+), 3 deletions(-)
 create mode 100644 daemon/apparmor_linux_test.go

diff --git a/daemon/apparmor_linux.go b/daemon/apparmor_linux.go
index efc553cd3e..9022fc653e 100644
--- a/daemon/apparmor_linux.go
+++ b/daemon/apparmor_linux.go
@@ -5,6 +5,15 @@
 	"github.com/moby/moby/v2/daemon/internal/rootless"
 )
 
+// appArmorProfileWithNoNewPrivileges returns a stacking profile when
+// no_new_privs prevents replacing the current AppArmor confinement.
+func appArmorProfileWithNoNewPrivileges(profile string, noNewPrivileges bool) string {
+	if !noNewPrivileges || profile == "" || profile[0] == '&' {
+		return profile
+	}
+	return "&" + profile
+}
