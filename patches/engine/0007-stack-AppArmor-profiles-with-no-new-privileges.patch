 	if detachedNetNS, _ := rootless.DetachedNetNS(); detachedNetNS != "" {
diff --git a/daemon/apparmor_linux_test.go b/daemon/apparmor_linux_test.go
new file mode 100644
index 0000000000..af812f7131
--- /dev/null
+++ b/daemon/apparmor_linux_test.go
@@ -0,0 +1,31 @@
+//go:build linux
+
+package daemon
+
+import (
+	"testing"
+
+	"gotest.tools/v3/assert"
+)
+
+func TestAppArmorProfileWithNoNewPrivileges(t *testing.T) {
+	tests := []struct {
+		name            string
+		profile         string
+		noNewPrivileges bool
+		expectedProfile string
+	}{
+		{name: "empty profile", noNewPrivileges: true},
+		{name: "without no new privileges", profile: defaultAppArmorProfile, expectedProfile: defaultAppArmorProfile},
+		{name: "default profile", profile: defaultAppArmorProfile, noNewPrivileges: true, expectedProfile: "&" + defaultAppArmorProfile},
+		{name: "custom profile", profile: "custom-profile", noNewPrivileges: true, expectedProfile: "&custom-profile"},
+		{name: "unconfined profile", profile: unconfinedAppArmorProfile, noNewPrivileges: true, expectedProfile: "&" + unconfinedAppArmorProfile},
+		{name: "already stacked", profile: "&custom-profile", noNewPrivileges: true, expectedProfile: "&custom-profile"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assert.Equal(t, appArmorProfileWithNoNewPrivileges(tc.profile, tc.noNewPrivileges), tc.expectedProfile)
+		})
+	}
+}
