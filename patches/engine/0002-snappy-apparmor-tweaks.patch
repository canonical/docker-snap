From bcc63ecfbc2ad8146c43fc24da554fc8d7b39698 Mon Sep 17 00:00:00 2001
From: Ivano Matrisciano <ivano.matrisciano@canonical.com>
Date: Mon, 8 Jun 2026 15:32:34 +0200
Subject: [PATCH 2/6] snappy apparmor tweaks

---
 .../moby/profiles/apparmor/template.go        | 21 ++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/vendor/github.com/moby/profiles/apparmor/template.go b/vendor/github.com/moby/profiles/apparmor/template.go
index 99873f3..6af483b 100644
--- a/vendor/github.com/moby/profiles/apparmor/template.go
+++ b/vendor/github.com/moby/profiles/apparmor/template.go
@@ -3,7 +3,10 @@
 
 package apparmor
 
-import "strings"
+import (
+	"os"
+	"strings"
+)
 
 // NOTE: This profile is replicated in containerd and libpod. If you make a
 //       change to this profile, please make follow-up PRs to those projects so
@@ -85,6 +88,10 @@
   # allow processes within the container to trace each other,
   # provided all other LSM and yama setting allow it.
   ptrace (trace,tracedby,read,readby) peer={{.PeerName}},
+{{- if .SnapDaemonProfile}}
+  # the snapped daemon is confined and inspects container processes.
+  ptrace (readby,tracedby) peer={{.SnapDaemonProfile}},
+{{- end}}
 }
 `
 
@@ -135,6 +142,18 @@ func (d profileData) DaemonProfile() string {
 	return quotePeerName(d.daemonProfile)
 }
 
+// SnapDaemonProfile returns the daemon's quoted peer pattern when it runs as
+// a confined snap, and an empty string otherwise.
+func (d profileData) SnapDaemonProfile() string {
+	if _, isSnap := os.LookupEnv("SNAP"); !isSnap {
+		return ""
+	}
+	if d.daemonProfile == "" || d.daemonProfile == "unconfined" {
+		return ""
+	}
+	return quotePeerName(d.daemonProfile)
+}
+
 // quoteProfileName quotes a profile declaration name. Declaration names retain
 // AARE escapes, so only embedded quotes are escaped here. The parser still
 // decodes recognized backslash escape sequences.
-- 
