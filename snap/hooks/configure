#!/bin/bash

set -eux

HOOK_LOG="${SNAP_COMMON}/hooks/${SNAP_REVISION}/$(basename "$0").log" && mkdir -p "${HOOK_LOG%/*}"
exec &> >(tee -a "${HOOK_LOG}")

. "${SNAP}/usr/share/nvidia-container-toolkit/lib"

# Keys a user may set via `snap set docker daemon.<key>=<value>`, which this hook merges
# into daemon.json. Allowlist excludes daemon options that could grant network/root
# access (hosts, tls*, authorization-plugins, runtimes, insecure-registries,
# registry-mirrors) and options the snap passes to dockerd as flags (data-root, group).
# Keys shipped with a value in the base config (log-level) are restored to that default
# when unset rather than dropped. Extend as concrete needs arise.
USER_DAEMON_KEYS='["default-address-pools","bip","fixed-cidr","fixed-cidr-v6","default-gateway","default-gateway-v6","mtu","dns","dns-search","dns-opts","default-ulimits","log-level"]'

apply_user_daemon_config() {
    local cfg="${SNAP_DATA}/config/daemon.json"
    local base doc overlay tmp

    # Snap-shipped defaults for allowlisted keys (e.g. log-level), so unsetting a key that
    # has a base default restores that default instead of dockerd's built-in.
    base="$(jq -c --argjson allow "$USER_DAEMON_KEYS" \
        'with_entries(select(.key as $k | $allow | index($k)))' "${SNAP}/config/daemon.json" 2>/dev/null || true)"
    jq -e 'type == "object"' <<<"$base" >/dev/null 2>&1 || base='{}'

    doc="$(snapctl get -d daemon 2>/dev/null || true)"
    [ -n "$doc" ] || doc='{}'

    # Overlay = only the allowlisted keys the user has actually set.
    overlay="$(jq -c --argjson allow "$USER_DAEMON_KEYS" \
        '(.daemon // {}) | with_entries(select(.key as $k | $allow | index($k)))' <<<"$doc" 2>/dev/null || true)"
    if ! jq -e 'type == "object"' <<<"$overlay" >/dev/null 2>&1; then
        echo "config: could not read daemon options; leaving daemon.json unchanged"
        return 0
    fi

    tmp="$(mktemp "${cfg}.XXXXXX")"
    # Drop every allowlisted key, restore the snap defaults for them, then apply the ones the
    # user has set (user value wins). Keys the snap or nvidia otherwise manage (runtimes, ...)
    # are untouched.
    if ! jq --argjson allow "$USER_DAEMON_KEYS" --argjson base "$base" --argjson overlay "$overlay" \
        'delpaths([ $allow[] | [.] ]) | . + $base + $overlay' "$cfg" > "$tmp" 2>/dev/null; then
        echo "config: failed to merge daemon options; leaving daemon.json unchanged"
        rm -f "$tmp"
        return 0
    fi

    # dockerd needs $SNAP/bin on PATH to locate docker-proxy during validation.
    if PATH="${SNAP}/bin:${SNAP}/usr/bin:${PATH}" "${SNAP}/bin/dockerd" \
        --validate --config-file="$tmp" >/dev/null 2>&1; then
        # Compare canonically so a pure reformat does not rewrite the file or restart the
        # daemon; only apply when the effective config actually changed.
        if jq -S . "$cfg" 2>/dev/null | cmp -s - <(jq -S . "$tmp" 2>/dev/null); then
            rm -f "$tmp"
        else
            mv "$tmp" "$cfg"
            SVC_RESTART=true
        fi
    else
        echo "config: rejected invalid daemon options from snap config; keeping current daemon.json"
        rm -f "$tmp"
    fi
}

# If the user unset the data-root, set it to the default
data_root="$(snapctl get data-root)"
if [ -z "$data_root" ] ; then
    snapctl set data-root="${DEFAULT_DATA_ROOT}"
fi

# Flag to trigger service restart if any condition requires it #
SVC_RESTART=false

# Apply user-provided daemon options set via `snap set docker daemon.<key>=<value>` #
apply_user_daemon_config

if nvidia_support_disabled; then

    # Remove nvidia runtime config, if it exists #
    jq -r 'del(.runtimes.nvidia)' "${SNAP_DATA}/config/daemon.json" > "${SNAP_DATA}/config/daemon.json.new"

    # If it was removed [ there was a change ], copy in the new config, remove CDI config,  and set service restart flag #
    if ! cmp "${SNAP_DATA}/config/daemon.json"{,.new} >/dev/null ; then
        mv "${SNAP_DATA}/config/daemon.json"{.new,}
        rm -f "${SNAP_DATA}/etc/cdi/nvidia.yaml"
        rm -f "${SNAP_DATA}/etc/nvidia-container-runtime/config.toml"
        SVC_RESTART=true
    fi

fi

# Restart services if required #
# If oneshot services are inactive they don't respond to restart, so stop/start #
if $SVC_RESTART ; then
    snapctl stop "${SNAP_NAME}"
    snapctl start "${SNAP_NAME}"
# Otherwise, just restart the nvidia-container-toolkit #
else
    snapctl stop "${SNAP_NAME}.nvidia-container-toolkit"
    snapctl start "${SNAP_NAME}.nvidia-container-toolkit"
fi
